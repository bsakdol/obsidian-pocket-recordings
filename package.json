{
	"name": "pocket-recordings",
	"version": "0.2.0",
	"description": "Sync Pocket recordings into conversation and insight notes, with transcripts, summaries, action items, and mind maps.",
	"main": "main.js",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "node --env-file-if-exists=.env esbuild.config.mjs",
		"build": "tsc --noEmit && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "node scripts/test.mjs"
	},
	"keywords": [],
	"license": "0BSD",
	"devDependencies": {
		"@eslint/js": "9.39.5",
		"@types/node": "22.20.5",
		"esbuild": "0.25.5",
		"eslint": "9.39.5",
		"eslint-plugin-obsidianmd": "0.5.1",
		"globals": "14.0.0",
		"jiti": "2.6.1",
		"obsidian": "1.14.4",
		"tslib": "2.8.1",
		"typescript": "5.8.3",
		"typescript-eslint": "8.72.2"
	}
}
